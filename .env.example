# Copy to .env and set your values. NEVER commit your real .env file.

# RPC Endpoints (Arbitrum One)
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
ARB_WSS_URL=wss://arb1.arbitrum.io/feed

# Deployer / Trader Private Key (without 0x prefix)
PRIVATE_KEY=your_private_key_here_for_testnet_or_fork

# Contract Addresses (Optional overrides, defaults to canonical addresses)
BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8
UNISWAP_V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
CAMELOT_ROUTER=0x1F721E2E82F6676FCE4eA07A5958cF098D339e18
